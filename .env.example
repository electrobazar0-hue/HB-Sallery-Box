# ===========================================
# HB Sallery Box - Environment Variables
# ===========================================
#
# Copy this file as .env.local for local development
# On Vercel, set these in Project Settings > Environment Variables
#

# Supabase Database URL
# Get from: Supabase > Settings > Database > Connection string > URI > "Direct connection"
DATABASE_URL="postgresql://postgres:<database-password>@db.<project-ref>.supabase.co:5432/postgres"

# Supabase Database - Direct URL (optional manual SQL/admin work)
# The app itself does not require DIRECT_URL.
DIRECT_URL="postgresql://postgres:<database-password>@db.<project-ref>.supabase.co:5432/postgres"

# Supabase project metadata
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<supabase-anon-key>"
