# HB Sallery Box - Environment Variables
#
# Copy this file as .env.local for local development.
# On Vercel, add these in Project Settings > Environment Variables.

# Prisma PostgreSQL database URL.
# Use Vercel Postgres, Neon, Railway, Render, or any PostgreSQL provider.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# NextAuth / app secret.
NEXTAUTH_URL="https://your-vercel-app.vercel.app"
NEXTAUTH_SECRET="generate-a-random-secret-here"
